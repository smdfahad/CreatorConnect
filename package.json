{
  "name": "creatorconnect",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron.cjs",

  "scripts": {
    "dev": "vite --port 5174",
    "build": "vite build",
    "preview": "vite preview",
    "app": "concurrently \"npm run dev\" \"wait-on http://localhost:5174 && electron electron.cjs\"",
    "dist": "npm run build && electron-builder"
  },

  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.468.0"
  },

  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "concurrently": "^10.0.5",
    "wait-on": "^9.1.0"
  },

  "build": {
    "appId": "com.creatorconnect.app",
    "productName": "CreatorConnect",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}